# Copia este fichero como .env y rellénalo. `npm start` lo lee solo.

# Cadena de conexión de Supabase: Project Settings > Database > Connect.
# Usa la de "Session pooler" (puerto 5432) o la conexión directa.
# Si la contraseña lleva símbolos, escríbelos codificados (@ -> %40, etc.).
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Opcional: certificado de Supabase (Database > SSL Configuration) para
# verificar el servidor. Sin él la conexión va cifrada pero sin verificar.
# DATABASE_CA_FILE=prod-ca-2021.crt

# Sin DATABASE_URL se usa SQLite en este fichero.
# DB_FILE=data/nidaria.db

# Avisos al móvil (Web Push). Sin claves, se generan solas la primera vez
# y se guardan en la base de datos. Para fijarlas: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contacto que va en cada aviso: mailto: o la dirección https del juego.
# VAPID_SUBJECT=https://tu-dominio
